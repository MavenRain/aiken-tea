              "$ref": "#/definitions/aiken~1crypto~1ScriptHash"
            }
          ]
        }
      ]
    },
    "tea/Queued": {
      "title": "Queued",
      "description": "One queued message: the inline datum of a UTxO at the queue script\n address. `author` alone may reclaim the entry (with a signature);\n `msg` is the application message, upcast to `Data` by the enqueuer.\n Locking the entry is the author's authorization of the message, so\n processing needs no further signature from them.",
      "anyOf": [
        {
          "title": "Queued",
          "dataType": "constructor",
          "index": 0,
