        }
      ]
    },
    "tea/Action<tea/counter/Msg>": {
      "title": "Action",
      "description": "Redeemer wrapper for a batch-capable app. `Single` carries one\n message, the ordinary TEA step. `Batch` names the queue script whose\n consumed entries carry the messages (see `batch`): the state\n validator reads them from its own transaction, so the batcher cannot\n apply messages it does not consume.",
      "anyOf": [
        {
          "title": "Single",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "$ref": "#/definitions/tea~1counter~1Msg"
            }
          ]
        },
        {
          "title": "Batch",
          "dataType": "constructor",
          "index": 1,
          "fields": [
